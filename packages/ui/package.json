{
  "name": "@oas-isui/ui",
  "version": "1.0.0",
  "description": "OAS-ISUI 框架无关 Web Components UI 组件库",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/types/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "sideEffects": [
    "**/*.css",
    "**/index.js",
    "**/index.ts"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@oas-isui/core": "workspace:*",
    "@oas-isui/icons": "workspace:*"
  }
}
