{
  "name": "@oas-isui/ssr",
  "version": "2.0.0",
  "description": "OAS-ISUI 服务端渲染（SSR）——renderToString 产出 Declarative Shadow DOM（DSD）静态快照",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/openappsys/oas-isui.git"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@oas-isui/i18n": "workspace:*",
    "@oas-isui/ui": "workspace:*",
    "happy-dom": "^20.11.2"
  }
}
